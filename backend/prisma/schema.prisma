generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  username             String    @default("")
  profession           String?
  /// Acteur : "user" (utilisatrice) ou "doctor" (professionnelle de santé).
  /// Le rôle "doctor" n'est accordé que par invitation (POST /doctors/register).
  role                 String   @default("user")
  /// Vérification du statut professionnel : "none" | "pending" | "verified" | "rejected"
  verificationStatus   String   @default("none")
  verifiedAt           DateTime?
  verifiedBy           String?
  /// Informations professionnelles (traçabilité, validation future par justificatifs)
  fullName             String?
  institution          String?
  licenseNumber        String?
  lastMenstruationDate String?
  durationMenstruation Int?
  cycleDuration        Int?
  profileImage         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  cycles   Cycle[]
  posts    Post[]
  likes    Like[]
  comments Comment[]
  messages Message[]
  notifications      Notification[] @relation("NotificationUser")
  actedNotifications Notification[] @relation("NotificationActor")
}

/// Code de connexion à usage unique, indexé par e-mail normalisé.
/// Invitation à rejoindre l'application des professionnelles de santé.
/// Créée par un administrateur (scripts/invite-doctor.js) ; à usage unique.
model DoctorInvitation {
  id          String    @id @default(uuid())
  /// E-mail attendu (minuscules). Null = code libre, utilisable avec n'importe quel e-mail.
  email       String?
  code        String    @unique
  note        String?
  createdBy   String?
  expiresAt   DateTime?
  usedAt      DateTime?
  usedById    String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

/// Notification in-app : like / commentaire sur ma publication, réponse à mon commentaire, message reçu.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  actorId   String
  type      String
  postId    String?
  commentId String?
  roomId    String?
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user  User @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model OtpRequest {
  email      String   @id
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
}

/// Les dates sont stockées telles que l'app les produit ("YYYY-MM-DD")
/// pour un aller-retour exact avec la base SQLite locale.
model Cycle {
  id                        String @id @default(uuid())
  userId                    String
  key                       String
  month                     String
  ovulationDate             String
  fecundityPeriodStart      String
  fecundityPeriodEnd        String
  startMenstruationDate     String
  endMenstruationDate       String
  nextMenstruationStartDate String
  nextMenstruationEndDate   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Post {
  id          String   @id @default(uuid())
  authorId    String
  title       String
  description String
  photos      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    Like[]
  comments Comment[]

  @@index([createdAt])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  /// Réponse à un autre commentaire du même post (un seul niveau).
  parentId  String?
  content   String
  createdAt DateTime @default(now())

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([parentId])
}

/// Salon privé entre deux utilisatrices : id = "uidA_uidB" (ids triés).
model Room {
  id        String   @id
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  /// « Supprimer la conversation » côté A / B : masque les messages antérieurs pour elle seule.
  userAClearedAt DateTime?
  userBClearedAt DateTime?

  messages Message[]

  @@index([userAId])
  @@index([userBId])
}

model Message {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  text      String   @default("")
  /// Pièce jointe optionnelle : "image" | "file" | "audio"
  attachmentType String?
  attachmentUrl  String?
  attachmentName String?
  attachmentSize Int?
  /// Durée d'un message vocal, en millisecondes
  durationMs     Int?
  /// Modifié / supprimé (suppression douce : contenu effacé, trace conservée) / lu par la destinataire
  editedAt  DateTime?
  deletedAt DateTime?
  readAt    DateTime?
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}
