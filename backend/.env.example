# Connexion PostgreSQL
DATABASE_URL="postgresql://ampela:ampela@localhost:5432/ampela?schema=public"

# Port HTTP de l'API
PORT=3200

# Secret de signature des JWT (générer avec: openssl rand -hex 32)
JWT_SECRET=change-me
JWT_EXPIRES_IN=90d

# URL publique de l'API (utilisée pour construire les liens des fichiers uploadés)
PUBLIC_URL=http://localhost:3200

# Envoi des codes de connexion. Sans SMTP_HOST, le code est seulement écrit dans les logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Ampela <no-reply@ampela.mg>"
