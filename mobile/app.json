{
  "expo": {
    "name": "Ampela",
    "slug": "Ampela",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maminiaina.ampela"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#FF7575"
      },
      "package": "com.maminiaina_mercia.Ampela",
      "permissions": [
        "android.permission.WAKE_LOCK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/favicon.png",
          "color": "#ffffff",
          "sounds": [
            "./assets/sound/notification.mp3"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cette application nécessite une permission d'accès à votre galerie"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autorisez $(PRODUCT_NAME) à utiliser Face ID pour déverrouiller l'application."
        }
      ],
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Autorisez $(PRODUCT_NAME) à utiliser le micro pour envoyer des messages vocaux."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FF7575"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "71d88606-9e38-42eb-a633-106e37e52f3d"
      }
    },
    "description": "Suivi du cycle menstruel, prédictions, rappels, forum et messagerie avec des professionnelles de santé.",
    "primaryColor": "#FF7575"
  }
}
